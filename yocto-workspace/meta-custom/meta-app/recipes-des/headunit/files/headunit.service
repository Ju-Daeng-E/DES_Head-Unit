[Unit]
Description=Head Unit (Qt Quick)
After=multi-user.target weston.service
Requires=weston.service

[Service]
Type=simple
Environment=QT_QPA_PLATFORM=wayland
# Force Wayland at runtime and surface QPA diagnostics
Environment=QT_LOGGING_RULES=qt.qpa.*=true;qt.wayland.*=true
Environment=QT_WAYLAND_DISABLE_WINDOWDECORATION=1
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=XDG_RUNTIME_DIR=/run
Environment=WAYLAND_DISPLAY=wayland-0
# Explicitly select the Wayland platform to avoid fallback to XCB
ExecStart=/usr/bin/HeadUnitApp -platform wayland
Restart=on-failure
RestartSec=5
User=weston
Group=wayland

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
