[Unit]
Description=Plymouth Quit Timer (7 seconds exact)
After=plymouth-start.service
Before=display-manager.service
DefaultDependencies=no

[Service]
Type=oneshot
# Wait exactly 7 seconds then quit Plymouth completely (release DRM)
# --retain-splash: Keep VT allocated (don't switch to console)
# This allows Weston to seamlessly take over the same VT
ExecStart=/bin/sh -c 'sleep 7 && /usr/bin/plymouth quit --retain-splash'
RemainAfterExit=yes
TimeoutStartSec=15

[Install]
WantedBy=sysinit.target
